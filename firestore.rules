rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userRole() {
      return getUserData().role;
    }
    function isOwner() {
      return isSignedIn() && request.auth.token.email == "wjohnston.media@gmail.com";
    }
    function isAdmin() {
      return isSignedIn() && userRole() in ['Admin', 'Master Admin', 'Owner'];
    }
    function isMasterAdminOrOwner() {
      return isSignedIn() && userRole() in ['Master Admin', 'Owner'];
    }
    function isNotBlocked() {
      return !getUserData().blocked;
    }
    function myEmail() {
      return request.auth.token.email;
    }

    // ─── Users ─────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Self-signup only: the doc ID must equal the caller's own uid.
      // Admins pre-create clients in /pendingClients instead (see below).
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && !('role' in request.resource.data.diff(resource.data).affectedKeys())) ||
        (isAdmin() && resource.data.email != "wjohnston.media@gmail.com") ||
        isOwner()
      );
      allow delete: if isMasterAdminOrOwner() && resource.data.email != "wjohnston.media@gmail.com";
    }

    // ─── Site settings ─────────────────────────────────
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Portfolio ─────────────────────────────────────
    // Old path — kept for backwards compatibility
    match /portfolio/{category}/items/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // New project-based path
    match /portfolio/{category}/projects/{project} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Messages ──────────────────────────────────────
    // Contact-form writes go through /api/contact using the Admin SDK, which
    // bypasses these rules — so the client SDK never needs create access.
    match /messages/{msgId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ─── Pending Clients ───────────────────────────────
    // Profiles an admin creates before the client has ever signed in.
    // Claimed on first login by lib/useAuth.ts, then removed.
    match /pendingClients/{email} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      // The claiming client deletes their own placeholder after linking it.
      allow delete: if isAdmin() || (isSignedIn() && email == myEmail());
    }

    // ─── Quotes ────────────────────────────────────────
    match /quotes/{quoteId} {
      // Public quote requests are written server-side by /api/quote.
      allow create: if isSignedIn() && isNotBlocked();
      // Clients see quotes linked by uid OR by the email they submitted —
      // requests made before they had an account only carry the email.
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clientEmail == myEmail() ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.clientId == request.auth.uid &&
        request.resource.data.status == 'Accepted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
      );
      allow delete: if isAdmin();
    }

    // ─── Client Projects ───────────────────────────────
    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clientEmail == myEmail() ||
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.clientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clientNote', 'clientNoteUpdatedAt'])
      );
      allow delete: if isMasterAdminOrOwner();
    }

    // ─── Square webhook de-duplication ─────────────────
    // Written only by the Admin SDK, which bypasses these rules entirely.
    // No client should ever read or write it.
    match /squareEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
