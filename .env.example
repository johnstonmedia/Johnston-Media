################################################################
# Johnston Media — environment variables
#
# Copy to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
################################################################

# ─── Site ─────────────────────────────────────────────────────
# Used for absolute URLs in emails and metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://wjohnstonmedia.com"


# ─── Firebase (browser) ───────────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app config.
# These are public by design; Firestore rules do the real protecting.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""


# ─── Firebase Admin (server — SECRET) ─────────────────────────
# Firebase Console → Project settings → Service accounts →
# "Generate new private key". Take these three fields from the JSON.
# Keep the \n escapes in the private key exactly as they appear.
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"


# ─── Square (server — SECRET) ─────────────────────────────────
# developer.squareup.com/apps → your app.
# Start with "sandbox" and swap to "production" when you're ready.
SQUARE_ENVIRONMENT="sandbox"
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_CURRENCY="AUD"

# Square dashboard → Webhooks → Subscriptions.
# Subscribe to: invoice.payment_made, invoice.updated, invoice.canceled,
#               invoice.refunded, invoice.scheduled_charge_failed
# Notification URL must match SQUARE_WEBHOOK_NOTIFICATION_URL exactly,
# because the signature is computed over URL + body.
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_NOTIFICATION_URL="https://wjohnstonmedia.com/api/square/webhook"

# Optional — pins the Square API version. Defaults to 2025-01-23.
# Set this to match the API version on your webhook subscription so both
# sides speak the same dialect.
# SQUARE_API_VERSION="2026-08-19"

# Optional — direct links from the admin panel into your Square Dashboard.
# Square doesn't document a deep-link format, so these are off by default and
# the admin falls back to the relevant Dashboard section. To turn them on,
# open a real invoice/customer in Square, copy its URL, and swap the id for
# the {id} placeholder.
# NEXT_PUBLIC_SQUARE_DASHBOARD_INVOICE_URL="https://app.squareup.com/dashboard/invoices/{id}"
# NEXT_PUBLIC_SQUARE_DASHBOARD_CUSTOMER_URL="https://app.squareup.com/dashboard/customers/{id}"


# ─── Email — Resend (server — SECRET) ─────────────────────────
# resend.com → API Keys. Verify wjohnstonmedia.com under Domains
# first, or sends from that address will be rejected.
RESEND_API_KEY=""
EMAIL_FROM="Johnston Media <hello@wjohnstonmedia.com>"
OWNER_NOTIFY_EMAIL="wjohnston.media@gmail.com"


# ─── Public contact details ───────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL="wjohnston.media@gmail.com"
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""

# ─────────────────────────────────────────────────────
# Email platform  (mail.wjohnstonmedia.com)
# ─────────────────────────────────────────────────────

# ── YOU INVENT THIS ──────────────────────────────────
# Not issued by any service: it's a password the code uses to sign unsubscribe
# links so nobody can forge one. Make a long random string:
#   openssl rand -base64 32          (Mac/Linux terminal)
#   crypto.randomUUID()+crypto.randomUUID()   (browser console, F12)
#   …or a password manager's generator, 40+ characters.
#
# SET IT ONCE AND LEAVE IT. It signs the links inside emails you have already
# sent; change it and every one of those stops working, which is both rude and,
# under the Spam Act, a problem.
EMAIL_UNSUBSCRIBE_SECRET=

# ── COPY AS-IS (or edit the wording) ─────────────────
# Shown as the sender's identification in campaign footers. The Spam Act
# requires a commercial message to say who sent it and how to reach them, so
# make it specific enough that someone could actually find you.
EMAIL_SENDER_ADDRESS="Johnston Media, New South Wales, Australia"

# ── COPY AS-IS ───────────────────────────────────────
# The from/reply-to on help replies. The address MUST be on the domain you
# verified in Resend — any other domain is rejected even with a valid key.
EMAIL_HELP_FROM="Johnston Media Help <help@wjohnstonmedia.com>"

# ── YOU INVENT THIS ──────────────────────────────────
# A second random string, different from the one above. Generated the same way.
# The forwarder that delivers your mail passes it back, which is how the
# endpoint knows a delivery is genuine. With this unset /api/email/inbound
# refuses everything — an open inbound endpoint is a spam funnel into the
# team's inbox.
EMAIL_INBOUND_SECRET=

# Shown in the platform UI. Public, so no secrets here.
NEXT_PUBLIC_EMAIL_FROM=hello@wjohnstonmedia.com
NEXT_PUBLIC_EMAIL_HELP=help@wjohnstonmedia.com
