################################################################
# Johnston Media — environment variables
#
# Copy to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
################################################################

# ─── Site ─────────────────────────────────────────────────────
# Used for absolute URLs in emails and metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://johnstonmedia.com.au"


# ─── Firebase (browser) ───────────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app config.
# These are public by design; Firestore rules do the real protecting.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""


# ─── Firebase Admin (server — SECRET) ─────────────────────────
# Firebase Console → Project settings → Service accounts →
# "Generate new private key". Take these three fields from the JSON.
# Keep the \n escapes in the private key exactly as they appear.
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"


# ─── Square (server — SECRET) ─────────────────────────────────
# developer.squareup.com/apps → your app.
# Start with "sandbox" and swap to "production" when you're ready.
SQUARE_ENVIRONMENT="sandbox"
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_CURRENCY="AUD"

# Square dashboard → Webhooks → Subscriptions.
# Subscribe to: invoice.payment_made and invoice.updated
# Notification URL must match SQUARE_WEBHOOK_NOTIFICATION_URL exactly,
# because the signature is computed over URL + body.
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_NOTIFICATION_URL="https://johnstonmedia.com.au/api/square/webhook"

# Optional — pins the Square API version. Defaults to 2025-01-23.
# SQUARE_API_VERSION="2025-01-23"


# ─── Email — Resend (server — SECRET) ─────────────────────────
# resend.com → API Keys. Verify johnstonmedia.com.au under Domains
# first, or sends from that address will be rejected.
RESEND_API_KEY=""
EMAIL_FROM="Johnston Media <hello@johnstonmedia.com.au>"
OWNER_NOTIFY_EMAIL="wjohnston.media@gmail.com"


# ─── Public contact details ───────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL="wjohnston.media@gmail.com"
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
