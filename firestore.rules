rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userRole() {
      return getUserData().role;
    }
    function isOwner() {
      return isSignedIn() && request.auth.token.email == "wjohnston.media@gmail.com";
    }
    function isAdmin() {
      return isSignedIn() && userRole() in ['Admin', 'Master Admin', 'Owner'];
    }
    function isMasterAdminOrOwner() {
      return isSignedIn() && userRole() in ['Master Admin', 'Owner'];
    }
    function isNotBlocked() {
      return !getUserData().blocked;
    }
    function myEmail() {
      return request.auth.token.email;
    }

    // ─── Users ─────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Self-signup only: the doc ID must equal the caller's own uid.
      // Admins pre-create clients in /pendingClients instead (see below).
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && !('role' in request.resource.data.diff(resource.data).affectedKeys())) ||
        (isAdmin() && resource.data.email != "wjohnston.media@gmail.com") ||
        isOwner()
      );
      allow delete: if isMasterAdminOrOwner() && resource.data.email != "wjohnston.media@gmail.com";
    }

    // ─── Site settings ─────────────────────────────────
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Portfolio ─────────────────────────────────────
    // Old path — kept for backwards compatibility
    match /portfolio/{category}/items/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // New project-based path
    match /portfolio/{category}/projects/{project} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Messages ──────────────────────────────────────
    // Contact-form writes go through /api/contact using the Admin SDK, which
    // bypasses these rules — so the client SDK never needs create access.
    match /messages/{msgId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ─── Pending Clients ───────────────────────────────
    // Profiles an admin creates before the client has ever signed in.
    // Claimed on first login by lib/useAuth.ts, then removed.
    match /pendingClients/{email} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      // The claiming client deletes their own placeholder after linking it.
      allow delete: if isAdmin() || (isSignedIn() && email == myEmail());
    }

    // ─── Quotes ────────────────────────────────────────
    match /quotes/{quoteId} {
      // Public quote requests are written server-side by /api/quote.
      allow create: if isSignedIn() && isNotBlocked();
      // Clients see quotes linked by uid OR by the email they submitted —
      // requests made before they had an account only carry the email.
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clientEmail == myEmail() ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.clientId == request.auth.uid &&
        request.resource.data.status == 'Accepted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
      );
      allow delete: if isAdmin();
    }

    // ─── Client Projects ───────────────────────────────
    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clientEmail == myEmail() ||
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.clientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clientNote', 'clientNoteUpdatedAt'])
      );
      allow delete: if isMasterAdminOrOwner();
    }

    // ─── Square webhook de-duplication ─────────────────
    // Written only by the Admin SDK, which bypasses these rules entirely.
    // No client should ever read or write it.
    match /squareEvents/{eventId} {
      allow read, write: if false;
    }

    // ─── Email platform ────────────────────────────────
    //
    // Read access is gated on holding an emailAccess record above "none";
    // every write that matters goes through the API with the Admin SDK, so
    // the rules here are deliberately read-mostly. The one thing that must
    // never be client-writable is emailAccess itself — a person who could
    // edit their own grant would have no limits at all.

    function emailLevel() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/emailAccess/$(request.auth.uid))
        ? get(/databases/$(database)/documents/emailAccess/$(request.auth.uid)).data.level
        : 'none';
    }

    function hasEmailAccess() {
      return isAdmin() || emailLevel() in ['read', 'draft', 'send', 'admin'];
    }

    function canDraft() {
      return isAdmin() || emailLevel() in ['draft', 'send', 'admin'];
    }

    /**
     * The mailboxes this person may read.
     *
     * Absent or empty means all of them — that is what everyone had before
     * the setting existed, and defaulting to "none" would lock people out of
     * mail they were already handling. A non-empty list is a restriction.
     *
     * The client also filters its list, but that only decides what is shown.
     * This is what decides what can be fetched.
     */
    function visibleMailboxes() {
      return get(/databases/$(database)/documents/emailAccess/$(request.auth.uid))
        .data.get('visibleMailboxes', []);
    }

    function canReadMailbox(box) {
      return isAdmin()
        || visibleMailboxes().size() == 0
        || box in visibleMailboxes();
    }

    match /emailAccess/{uid} {
      // You may see your own grant, so the app can tell you what you have.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      // Granted only through /api/email/access, which checks the caller.
      allow write: if false;
    }

    match /contacts/{contactId} {
      allow read: if hasEmailAccess();
      allow create, update: if canDraft();
      // Unsubscribes are a legal record — they are never deleted from here.
      allow delete: if isAdmin();
    }

    match /audiences/{audienceId} {
      allow read: if hasEmailAccess();
      allow write: if canDraft();
    }

    match /campaigns/{campaignId} {
      allow read: if hasEmailAccess();
      // Sending is server-side; the client only ever edits a draft.
      allow create, update: if canDraft();
      allow delete: if canDraft();
    }

    match /mailboxes/{address} {
      allow read: if hasEmailAccess();
      allow write: if isAdmin();
    }

    match /emailTemplates/{templateId} {
      allow read: if hasEmailAccess();
      allow write: if canDraft();
    }

    match /helpThreads/{threadId} {
      // Legacy threads predate mailboxes and were all help@.
      allow read: if hasEmailAccess()
        && canReadMailbox(resource.data.get('mailbox', 'help@wjohnstonmedia.com'));
      // Only the read/unread flag is worth a direct write; everything else
      // arrives from the inbound webhook or goes out through /api/email/reply.
      allow update: if canDraft();
      allow create, delete: if false;

      match /messages/{messageId} {
        // A message is only as readable as the thread that holds it.
        allow read: if hasEmailAccess()
          && canReadMailbox(
            get(/databases/$(database)/documents/helpThreads/$(threadId))
              .data.get('mailbox', 'help@wjohnstonmedia.com'));
        allow write: if false;
      }
    }
  }
}
